{
  "name": "@99linesofcode/opencode-socket-plugin",
  "version": "0.1.0",
  "description": "Expose the active opencode session over a Unix domain socket. Proxies the opencode HTTP API (session prompt, messages, SSE events) so other processes can inject into and watch the live TUI session.",
  "type": "module",
  "license": "MIT",
  "author": "Jordy Schreuders <99linesofcode@gmail.com>",
  "keywords": [
    "opencode",
    "plugin",
    "unix-socket",
    "socket",
    "sse",
    "session",
    "bridge"
  ],
  "exports": {
    ".": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    },
    "./server": {
      "import": "./build/index.js",
      "types": "./build/index.d.ts"
    }
  },
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "dev": "tsc -w",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit": "bun audit",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.15.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.31",
    "@opencode-ai/sdk": "^1.15.10",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26",
    "bun-types": "^1.4.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "prettier": "^3",
    "typescript": "^7",
    "typescript-eslint": "^8",
    "vitest": "^5"
  },
  "engines": {
    "opencode": ">=1.15.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
